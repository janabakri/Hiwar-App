# Application
APP_NAME=HIWAR App
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# Security
SECRET_KEY=your-super-secret-key-change-in-production
GOOGLE_CLIENT_ID=333737150095-hndinb3nv3h8o368gcrde3s69ond2l35.apps.googleusercontent.com
# iOS Bundle ID registered for Sign in with Apple, e.g. com.hiwar.app
APPLE_CLIENT_ID=com.hiwar.app
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./app.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# Optional in V1; reserved for temporary session state and rate limiting.
REDIS_URL=

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7
# Structured Tutor Orchestrator calls. Keep API keys in deployment secrets,
# never in Flutter or GitHub.
AI_TUTOR_MODEL=gpt-4o-mini
AI_TUTOR_MAX_TOKENS=900
AI_TUTOR_TIMEOUT_SECONDS=20

# Evidence-gated learner memory and privacy
MEMORY_MIN_CONFIDENCE=0.86
MEMORY_REPEAT_THRESHOLD=2
# Raw audio is not retained unless a future explicit-consent flow enables it.
AUDIO_RETENTION_ENABLED=False

# Email verification (SMTP)
# Example for Gmail: smtp.gmail.com / port 587 / TLS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@example.com

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173

# Voice (Optional)
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
